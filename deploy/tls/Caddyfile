# TLS edge for the Daedelus control plane (development PKI from deploy/provision.py --tls).
{
	admin off
	auto_https disable_redirects
	persist_config off
}

https://localhost:8443, https://control.daedelus.internal:8443, https://127.0.0.1:8443 {
	tls /certs/server.crt /certs/server.key {
		protocols tls1.2 tls1.3
	}
	reverse_proxy control:8765 {
		# server-sent events must not be buffered
		flush_interval -1
	}
	header Strict-Transport-Security "max-age=31536000"
}

# any other Host header (e.g. a DNS-rebinding page) never reaches the control plane
https://:8443 {
	tls /certs/server.crt /certs/server.key
	respond "misdirected request" 421
}
