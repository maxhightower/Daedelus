# copy to deploy/.env and replace every value with a long random string (>= 16 chars)
DAEDELUS_API_TOKENS=change-me-admin-token-0000000000
DAEDELUS_WORKER_TOKENS=change-me-worker-token-000000000
DAEDELUS_WORKER_TOKEN=change-me-worker-token-000000000
