       {
        "op": "add_paragraph",
        "component_id": null,
        "params": {
         "id": "summary_text",
         "parent": "summary",
         "text": "These notes accompany the annual mean carbon dioxide record from Mauna Loa Observatory, Hawaii. The record is the longest continuous series of direct atmospheric CO2 measurements and is widely used as a reference for the background concentration of the Northern Hemisphere."
        },
        "derived_from": [
         "bind_1ef7f1988072"
        ],
        "rationale": "quoted from 'research_notes.md'"
       },
       {
        "op": "add_heading",
        "component_id": null,
        "params": {
         "id": "data_method",
         "text": "Data and method",
         "level": 1
        },
        "derived_from": [
         "bind_1ef7f1988072"
        ],
        "rationale": ""
       },
       {
        "op": "add_paragraph",
        "component_id": null,
        "params": {
         "id": "data_method_text",
         "parent": "data_method",
         "text": "The annual means are published by the NOAA Global Monitoring Laboratory. Values are expressed as a mole fraction in dry air in parts per million (ppm). Data from March 1958 through April 1974 were obtained by C. David Keeling of the Scripps Institution of Oceanography. The values for the most recent year are provisional and can change after recalibration of the reference gases. All figures in this report are computed in the linked analysis workbook; tables and charts update when the workbook changes."
        },
        "derived_from": [
         "bind_1ef7f1988072"
        ],
        "rationale": ""
       },
       {
        "op": "add_heading",
        "component_id": null,
