        ],
        "rationale": ""
       },
       {
        "op": "add_heading",
        "component_id": null,
        "params": {
         "id": "discussion",
         "text": "Discussion",
         "level": 1
        },
        "derived_from": [
         "bind_1ef7f1988072"
        ],
        "rationale": ""
       },
       {
        "op": "add_paragraph",
        "component_id": null,
        "params": {
         "id": "discussion_p1",
         "parent": "discussion",
         "text": "The analysis in this report is limited to describing the published annual means and their decade averages; it does not attempt attribution or projection."
        },
        "derived_from": [
         "bind_1ef7f1988072"
        ],
        "rationale": "quoted from 'research_notes.md'"
       },
       {
        "op": "add_paragraph",
        "component_id": null,
        "params": {
         "id": "discussion_p2",
         "parent": "discussion",
         "text": "Readers should note the gap in on-site measurements after the eruption of Mauna Loa in late November 2022: observations from December 2022 to July 2023 come from the Maunakea Observatories, about 21 miles to the north."
        },
        "derived_from": [
         "bind_1ef7f1988072"
        ],
