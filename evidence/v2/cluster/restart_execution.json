        "op": "add_paragraph",
        "component_id": null,
        "params": {
         "id": "summary_text",
         "parent": "summary",
         "text": "These notes accompany the annual mean carbon dioxide record from Mauna Loa Observatory, Hawaii. The record is the longest continuous series of direct atmospheric CO2 measurements and is widely used as a reference for the background concentration of the Northern Hemisphere."
        },
        "derived_from": [
         "bind_a3ce4c2b5342"
        ],
        "rationale": "quoted from 'research_notes.md'"
       },
